# meelarp configuration — copy this file to .env and fill it in
# (run `npm run setup` to create .env with a random session secret for you)

# --- required -------------------------------------------------------------
# From https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Same page → General Information → Application ID
CLIENT_ID=
# → OAuth2 → Client Secret (needed for the dashboard login)
CLIENT_SECRET=

# --- dashboard ------------------------------------------------------------
PORT=3400
# The URL people open the dashboard on. Must exactly match the redirect URI
# you add in the Discord developer portal: <BASE_URL>/callback
BASE_URL=http://localhost:3400
# Any long random string — signs the dashboard session cookies
SESSION_SECRET=

# --- optional -------------------------------------------------------------
# Comma separated Discord user IDs with owner-level access
OWNER_IDS=
# Twitch live alerts (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Where the SQLite database lives
DB_PATH=
DEBUG=false
